# Blank checklist for EXTERNAL hosting only. Never fill/commit secret values.
# Public build-time destination configuration:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-only configuration (same destination):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Obtain privileged key from YOUR destination. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Existing hosted payment flow:
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Optional own QR; leave unset for existing hosted default:
PAYMENT_QR_SOURCE=
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_RELAY_URL=
BAKONG_RELAY_SECRET=
# Current gateway dependencies; not portable by copying credentials.
# TELEGRAM_API_KEY is a connector key, NOT a bot token. See migration guide.
LOVABLE_API_KEY=
TELEGRAM_API_KEY=
# Optional SMS; phone sign-in is currently unavailable in the UI:
PLASGATE_PRIVATE_KEY=
PLASGATE_SECRET=
OTP_PEPPER=
# Google credentials belong in destination auth settings, not browser code.
